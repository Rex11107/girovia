  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/cli": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3",
    "@eslint/js": "9.17.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@playwright/test": "1.56.1",
    "eslint": "10.13.0",
    "globals": "15.14.0",
    "html-validate": "9.1.3",
    "http-server": "14.1.1",
    "leaflet": "^1.9.4"
  }
