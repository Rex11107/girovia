{
  "name": "girovia",
  "private": true,
  "version": "0.2.0",
  "description": "Mezzi pubblici, auto e piedi per Firenze e la Toscana",
  "license": "MIT",
  "scripts": {
    "lint": "eslint . && html-validate index.html privacy.html",
    "test": "npm run test:unit && playwright test --project=mock --project=offline",
